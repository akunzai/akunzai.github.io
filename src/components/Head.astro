---
import Default from '@astrojs/starlight/components/Head.astro'
import jetbrainsMono400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url'
import jetbrainsMono700 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-700-normal.woff2?url'
import CloudflareAnalytics from './CloudflareAnalytics.astro'
import SentryErrorTracking from './SentryErrorTracking.astro'
---

<Default><slot /></Default>
<script is:inline>
	try {
		if (localStorage.getItem('starlight-focus-mode') === 'true') {
			document.documentElement.setAttribute('data-focus-mode', '')
		}
	} catch {}
</script>
<link rel="preload" href={jetbrainsMono400} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={jetbrainsMono700} as="font" type="font/woff2" crossorigin />
<CloudflareAnalytics />
<SentryErrorTracking />
