---
---
<html>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const preferred = (navigator.languages?.[0] || navigator.language || '').toLowerCase()
      const target = preferred.startsWith('zh') ? '/zh-tw/' : '/en/'
      location.replace(target)
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
  </head>
</html>
